#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# godot-sqlite(GDExtension) 원본을 엔진에 정적 링크 — compat/ 가 godot_cpp 헤더를 엔진 헤더로 잇는다.
env_sqlite = env_modules.Clone()
env_sqlite.Prepend(CPPPATH=["#modules/sqlite/compat", "#modules/sqlite/godot-sqlite"])

env_thirdparty = env_sqlite.Clone()
env_thirdparty.disable_warnings()
env_thirdparty.Append(CPPDEFINES=["SQLITE_ENABLE_MATH_FUNCTIONS"])
thirdparty_obj = []
env_thirdparty.add_source_files(thirdparty_obj, "godot-sqlite/sqlite/sqlite3.c")
env.modules_sources += thirdparty_obj

module_obj = []
env_sqlite.add_source_files(module_obj, "register_types.cpp")
env_sqlite.add_source_files(module_obj, "godot-sqlite/gdsqlite.cpp")
env_sqlite.add_source_files(module_obj, "godot-sqlite/vfs/*.cpp")
env.modules_sources += module_obj

env.Depends(module_obj, thirdparty_obj)
