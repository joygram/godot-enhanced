<!--
  Adapted from:
  https://github.com/lambdageek/monovm-embed-sample/blob/c35f945509b0d1e4f4412a7076c9e769708c3ff1/src/GetRuntimePack/GetRuntimePack.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Game projects exported for the web must target the same framework. -->
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <!-- This plus a non-empty $(RuntimeIdentifier) are enough to choose Mono. -->
  <PropertyGroup>
    <UseMonoRuntime>true</UseMonoRuntime>
  </PropertyGroup>

  <!-- TODO: Hack to make the included stubs get the correct name in pinvoke-table.h -->
  <PropertyGroup>
    <AssemblyName>GodotSharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The WebAssembly SDK only treats the project as a browser-wasm app (IsBrowserWasmProject) when OutputType is
    not Library, and only generates wasm_m2n_invoke.g.h, pinvoke-table.h and icall-table.h (included by the
    runtime's runtime.c) when it builds natively. The .NET 11 SDK no longer does either on its own for this project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <!-- Configuration for the Mono WASM runtime. Must match the features supported by the Godot build. -->
  <!-- GodotWebThreads: set by mono_configure.py from the SCons 'threads' option. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <GodotWebThreads Condition="'$(GodotWebThreads)' == ''">true</GodotWebThreads>
    <WasmEnableThreads>$(GodotWebThreads)</WasmEnableThreads>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>

  <!--
    This is required to prevent trimming the GodotSharp stub functions included in this assembly for 'browser-wasm'.
    Otherwise, the generator won't add them to 'pinvoke-table.h'.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>

  <!--
    This is required to prevent trimming functions in the generated sources in 'browser-wasm/wasm/for-publish'
    Otherwise, initializing the runtime fails with 'Environment.FailFast'.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
  </ItemGroup>

  <!--
    NativePackages.props: written by mono_configure.py from the SCons option mono_wasm_native_packages
    (PackageReference items). Their assemblies are kept so the generator puts their P/Invokes in
    pinvoke-table.h, and their native browser-wasm libraries (NativeFileReference) are listed for
    mono_configure.py to link.
  -->
  <Import Project="NativePackages.props" Condition="Exists('NativePackages.props')" />
  <Target Name="GodotKeepNativePackageAssemblies" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <TrimmerRootAssembly Include="@(ReferenceCopyLocalPaths->'%(Filename)')" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''" />
    </ItemGroup>
  </Target>
  <Target Name="GodotListNativeReferences" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <WriteLinesToFile Overwrite="true" File="bin\$(RuntimeIdentifier)\native-references.txt" Lines="@(NativeFileReference->'%(FullPath)')" />
  </Target>

  <Target Name="EchoRuntimeLocation" AfterTargets="ResolveFrameworkReferences">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Message="Need to set RuntimeIdentifier to the target platform RID" />
    <ItemGroup>
      <ProbablyMono Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="@(ProbablyMono->Count()) != 1" Text="Expected to get exactly one Microsoft.NETCore.App.Mono resolved runtime pack, got @(ProbablyMono->Count())" />
    <PropertyGroup>
      <LikelyMono>@(ProbablyMono)</LikelyMono>
    </PropertyGroup>
    <Error Condition="!$(LikelyMono.Contains('Microsoft.NETCore.App.Runtime.Mono'))" Message="Expected '@(ProbablyMono)' to include 'Microsoft.NETCore.App.Runtime.Mono' in the name." />
    <Message Importance="High" Text="Runtime pack %(ProbablyMono.Identity) is in: %(ProbablyMono.PackageDirectory)"/>
    <WriteLinesToFile Overwrite="true" File="bin\$(RuntimeIdentifier)\runtime-pack-dir.txt" Lines="%(ProbablyMono.PackageDirectory)" />
  </Target>

</Project>
